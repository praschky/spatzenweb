---
import {
  getCollection,
  getEntry,
  type CollectionEntry,
  type CollectionKey,
} from "astro:content";

type PageData = {
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  draft?: boolean;
};

export const getSinglePage = async <C extends CollectionKey>(
  collectionName: C
): Promise<CollectionEntry<C>[]> => {
  const allPages = await getCollection(
    collectionName,
    ({ data, id }: CollectionEntry<C>) =>
      !(data as PageData)?.draft && !id.startsWith("-") && !id.endsWith("-en")
  );
  return allPages;
};

export const getListPage = async <C extends CollectionKey>(
  collectionName: C,
  documentId: "-index" | string
): Promise<CollectionEntry<C>> => {
  const data = (await getEntry(
    collectionName,
    documentId
  )) as CollectionEntry<C> | null;

  if (!data) {
    throw new Error(
      `No page found for the collection: ${collectionName} with filename: ${documentId}`
    );
  }

  return data;
};

// Language-aware entry lookup: for "en", prefer the "<id>.en" variant and
// fall back to the German entry when no translation exists.
export const getListPageForLang = async <C extends CollectionKey>(
  collectionName: C,
  documentId: "-index" | string,
  lang: "de" | "en"
): Promise<CollectionEntry<C>> => {
  if (lang === "en") {
    const enEntry = (await getEntry(
      collectionName,
      `${documentId}-en`
    )) as CollectionEntry<C> | null;
    if (enEntry) return enEntry;
  }
  return getListPage(collectionName, documentId);
};
---
