---
// Schulrichtlinien / School Guidelines page
import TitleBadge from "@/components/TitleBadge.astro";
import Base from "@/layouts/Base.astro";
import CallToActionSecondary from "@/partials/CallToActionSecondary.astro";

const guidelines = [
  {
    title: "Commitment to Child Safety Statement",
    desc: "Unser Bekenntnis zur Sicherheit aller Kinder an der Spatzenschule Melbourne.",
    icon: "🛡️",
    href: "/content/forms/Spatzenschule-Commitment-to-Child-Safety-Statement-for-web.pdf",
  },
  {
    title: "Child Safe Policy",
    desc: "Unsere umfassende Richtlinie zum Schutz von Kindern – beschreibt Verantwortlichkeiten und Verfahren.",
    icon: "📋",
    href: "/content/forms/2026%20Child%20Safety%20Responding%20and%20Reporting.pdf",
  },
  {
    title: "Child Safe Code of Conduct",
    desc: "Verhaltenskodex für alle Personen, die mit Kindern an der Spatzenschule in Kontakt kommen.",
    icon: "✅",
    href: "/content/forms/2026%20Code%20of%20Conduct.pdf",
  },
  {
    title: "Virtual Classroom Policy",
    desc: "Richtlinien für den Online-Unterricht und virtuelle Klassenräume.",
    icon: "💻",
    href: "/content/forms/Spatzenschule-Virtual-Classroom-Policy.pdf",
  },
  {
    title: "Annual Consent Form: Photographing and Filming Students",
    desc: "Einwilligungsformular für die Aufnahme und Verwendung von Fotos und Videos der Schüler:innen.",
    icon: "📸",
    href: "/content/forms/Spatzenschule-Annual-Consent-Form-Photographing-and-Filming-Students.pdf",
  },
];
---

<Base
  title="Schulrichtlinien"
  meta_title="Schulrichtlinien – Spatzenschule Melbourne"
  description="Übersicht über die Schulrichtlinien der Spatzenschule Melbourne: Child Safety Policy, Verhaltenskodex, Virtual Classroom Policy und weitere wichtige Informationen."
>
  <section class="section-lg">
    <div class="container">
      <!-- Section Title -->
      <div data-aos="fade-up-sm" data-aos-delay="100" class="row justify-center">
        <div class="col-10 lg:col-7">
          <TitleBadge
            icon="FaShield"
            label="Schulrichtlinien"
            bg_color="bg-secondary"
          />
          <h2 class="py-4 text-center">Schulrichtlinien</h2>
          <p class="text-center text-balance">
            Nachfolgend finden Sie einen Überblick über die Schulrichtlinien der
            Spatzenschule. Diese Richtlinien dienen dazu, die Sicherheit, das
            Wohlbefinden und die bestmögliche Lernumgebung für unsere
            Schüler:innen zu gewährleisten.
          </p>
          <p class="text-center text-sm text-text-dark mt-2">
            Alle Dokumente sind in englischer Sprache verfügbar.
          </p>
        </div>
      </div>

      <!-- Guidelines list -->
      <div class="pt-14 row g-4 justify-center">
        <div class="lg:col-8">
          <div class="space-y-4" data-aos="fade-up-sm">
            {
              guidelines.map((item, i) => (
                <div class="flex gap-5 items-start p-6 bg-dark/2 rounded-2xl">
                  <span class="text-3xl shrink-0">{item.icon}</span>
                  <div class="flex-1">
                    <h4 class="font-semibold mb-1">{item.title}</h4>
                    <p class="text-sm text-text-dark">{item.desc}</p>
                  </div>
                  <a
                    href={item.href}
                    class="btn btn-sm btn-outline-primary shrink-0"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download
                  </a>
                </div>
              ))
            }
          </div>

          <div class="mt-10 bg-secondary/10 border border-secondary/20 rounded-2xl p-8" data-aos="fade-up-sm">
            <p class="text-center">
              Wir empfehlen allen Eltern, diese Richtlinien sorgfältig zu lesen und bei Fragen unser
              Team zu kontaktieren.
            </p>
            <div class="text-center mt-6">
              <a
                href="mailto:enrolments.spatzenschule@gmail.com"
                class="btn btn-primary"
              >
                Kontakt aufnehmen
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- English version -->
  <section class="section pt-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-8" data-aos="fade-up-sm">
          <div class="bg-dark/2 rounded-2xl p-8">
            <h3 class="h4 font-semibold mb-4">🇬🇧 School Guidelines</h3>
            <p class="mb-4 text-text-dark">
              Below you can find an overview of the Spatzenschule school guidelines.
              These guidelines ensure the safety, well-being, and optimal learning
              environment for our students. All documents are available in English.
            </p>
            <ul class="space-y-2 text-text-dark list-disc list-inside">
              <li>Commitment to Child Safety Statement</li>
              <li>Child Safe Policy</li>
              <li>Child Safe Code of Conduct</li>
              <li>Virtual Classroom Policy</li>
              <li>Annual Consent Form: Photographing and Filming Students</li>
            </ul>
            <p class="mt-4 text-text-dark">
              We encourage all parents to read these guidelines carefully and contact
              our team if you have any questions.
            </p>
            <div class="mt-6">
              <a
                href="mailto:enrolments.spatzenschule@gmail.com"
                class="btn btn-primary"
              >
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToActionSecondary />
</Base>
