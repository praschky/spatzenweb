---
// Über uns – German URL alias for about content
import ImageMod from "@/components/ImageMod.astro";
import TitleBadge from "@/components/TitleBadge.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/components/Features.astro";
import ImpactResults from "@/components/ImpactResults.astro";
import CallToActionSecondary from "@/partials/CallToActionSecondary.astro";
import NumbersBanner from "@/partials/NumbersBanner.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";

const aboutIndex = await getListPage("about", "-index");
const {
  title,
  description,
  image,
  badge,
  button,
  features,
  numbers_banner,
  impact_results,
  brands,
  team,
} = aboutIndex.data;
const { Content } = await render(aboutIndex);
---

<Base {...aboutIndex.data}>
  <section class="section-lg">
    <div class="container">
      <div
        data-aos="fade-up-sm"
        data-aos-delay="150"
        class="row justify-between items-center max-lg:text-center"
      >
        <div class="lg:col-7">
          <TitleBadge
            icon={badge.icon}
            label={badge.label}
            bg_color={badge.bg_color}
            isCenter={false}
          />
          <h2 class="py-4 h1" set:html={markdownify(title || "")} />
        </div>

        <div class="lg:col-5">
          <p class="text-balance" set:html={markdownify(description || "")} />
          {
            button?.enable && (
              <a href={button.link} class="btn btn-primary mt-4">
                {button.label}
              </a>
            )
          }
        </div>

        <ImageMod
          src={image!}
          alt={title || "Über uns"}
          width={896}
          height={504}
          class="w-full max-w-4xl mx-auto rounded-4xl pt-12"
          format="webp"
          loading={"eager"}
        />
      </div>

      <!-- Features section -->
      <Features features={features} />
    </div>
  </section>

  {
    numbers_banner.enable && (
      <section class="section pt-0">
        <div class="container">
          <div
            data-aos="fade-up-sm"
            data-aos-delay="150"
            class="row justify-center"
          >
            <div class="col-11 lg:col-7">
              {numbers_banner.badge.enable && (
                <TitleBadge
                  icon={numbers_banner.badge.icon}
                  label={numbers_banner.badge.label}
                  bg_color={numbers_banner.badge.bg_color}
                />
              )}
              <h2
                class="py-4 text-center"
                set:html={markdownify(numbers_banner.title || "")}
              />
              <p
                class="text-center text-balance"
                set:html={markdownify(numbers_banner.description || "")}
              />
            </div>
          </div>

          <NumbersBanner
            numbers_banner={numbers_banner}
            bgColor="bg-tertiary/60"
          />

          <ImpactResults impactResults={impact_results} />
        </div>
      </section>
    )
  }

  <!-- Main body content -->
  <section class="section pt-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9">
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToActionSecondary />
</Base>
